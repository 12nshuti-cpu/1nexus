from PySide6.QtCore import (
    QObject,
    Signal,
    Slot,
)


class AIWorker(QObject):

    finished = Signal(
        int,
        str,
        str,
    )

    error = Signal(
        int,
        str,
        str,
    )

    def __init__(
        self,
        ai_service,
        conversation_id,
        message,
        conversation,
    ):
        super().__init__()

        self.ai_service = ai_service

        self.conversation_id = conversation_id

        self.message = message

        self.conversation = conversation

    # ==========================================================
    # RUN
    # ==========================================================

    @Slot()
    def run(self):

        try:

            response = self.ai_service.ask(
                self.message,
                self.conversation,
            )

            self.finished.emit(
                self.conversation_id,
                self.message,
                response,
            )

        except Exception as error:

            self.error.emit(
                self.conversation_id,
                self.message,
                str(error),
            )
