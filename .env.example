# NEXUS environment variables - EXAMPLE ONLY, contains no real credentials.
#
# NEXUS does NOT read a .env file. These are real process environment variables;
# set them in Windows (System Properties > Environment Variables, or
# `setx GEMINI_API_KEY "..."`) if you prefer that to entering the key in
# Settings. A key saved in Settings goes to the Windows Credential Manager
# (via keyring). Only if no credential store exists does NEXUS fall back to a
# plain-text file in your NEXUS data folder - it says so in Settings when that happens.
#
# Never commit a real key. .gitignore already excludes .env and *.key.

# Online AI (Google Gemini). Checked in this order: GEMINI_API_KEY, GOOGLE_API_KEY,
# NEXUS_GEMINI_API_KEY. An environment variable wins over a key saved in Settings.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# NEXUS_GEMINI_API_KEY=

# Optional: store NEXUS data (database, settings, logs) somewhere other than %LOCALAPPDATA%\NEXUS
# NEXUS_DATA_DIR=

# Optional: use a specific Python 3.10-3.12 for the Kokoro voice runtime
# NEXUS_KOKORO_PYTHON=

# Optional (testing only): skip the OS credential store
# NEXUS_DISABLE_KEYRING=1
