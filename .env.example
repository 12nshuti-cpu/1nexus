# NEXUS Environment Variables (do not commit real keys)
# Copy to .env and set your values

# Ollama (local)
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_MODEL=nexus
NEXUS_BASE_MODEL=llama3.1:8b

# Gemini (online) - optional
GEMINI_API_KEY=
GOOGLE_API_KEY=
NEXUS_GEMINI_TEXT_MODEL=gemini-2.0-flash

# OpenAI legacy voice (optional)
OPENAI_API_KEY=
NEXUS_STT_MODEL=gpt-transcribe
NEXUS_TTS_MODEL=gpt-4o-mini-tts
NEXUS_TTS_VOICE=marin

# Kokoro (local TTS via helper)
NEXUS_KOKORO_PYTHON=
